+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -36,6 +36,20 @@ WINE_DEFAULT_DEBUG_CHANNEL(ntoskrnl);
 WINE_DECLARE_DEBUG_CHANNEL(relay);
 
 BOOLEAN KdDebuggerEnabled = FALSE;
+BOOLEAN KdDebuggerNotPresent = TRUE;
+
+/* Kernel address-space boundaries.  Windows keeps the kernel mapped above
+ * 0xffff800000000000 on x86-64 and above 0x80000000 on i386; drivers read these
+ * variables directly (they are data exports, not functions). */
+#ifdef _WIN64
+PVOID MmSystemRangeStart = (PVOID)0xffff800000000000ULL;
+PVOID MmHighestUserAddress = (PVOID)0x00007ffffffe0000ULL;
+PVOID MmUserProbeAddress = (PVOID)0x00007ffffffe0000ULL;
+#else
+PVOID MmSystemRangeStart = (PVOID)0x80000000UL;
+PVOID MmHighestUserAddress = (PVOID)0x7fff0000UL;
+PVOID MmUserProbeAddress = (PVOID)0x7fff0000UL;
+#endif
 ULONG InitSafeBootMode = 0;
 USHORT NtBuildNumber = 0;
 
@@ -3928,6 +3942,26 @@ NTSTATUS WINAPI IoUnregisterPlugPlayNotification(PVOID notification)
     return STATUS_SUCCESS;
 }
 
+/*****************************************************
+ *           IoUnregisterPlugPlayNotificationEx    (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI IoUnregisterPlugPlayNotificationEx( PVOID notification )
+{
+    TRACE( "(%p)\n", notification );
+    return IoUnregisterPlugPlayNotification( notification );
+}
+
+/*****************************************************
+ *           KeQueryPrcbAddress    (NTOSKRNL.EXE.@)
+ */
+PVOID WINAPI KeQueryPrcbAddress( ULONG number )
+{
+    static BYTE prcb[64][0x800];
+
+    FIXME( "(%lu) semi-stub\n", number );
+    return prcb[number % 64];
+}
